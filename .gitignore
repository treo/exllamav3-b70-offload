*.egg-info/
build/
uv.lock

*.pyc
__pycache__/
.idea
venv
dist

# produced by `pip install -e .`
exllamav3_ext.cpython-*.so

# written next to the sources by torch's hipify during ROCm builds
exllamav3/exllamav3_ext/**/*.hip
exllamav3/exllamav3_ext/**/*_hip.*
exllamav3/exllamav3_ext/**/hip_*

# per-machine test model registry overrides (tests/testlib/models.py)
tests/models.local.yaml

# sycl_moe build artifacts and experiment binaries (sources + README/NOTES/env.sh are tracked;
# rebuild per README). archive/ = the topical working log split out of NOTES.md: docs only.
sycl_moe/*
!sycl_moe/*.cpp
!sycl_moe/*.hpp
!sycl_moe/*.h
!sycl_moe/*.py
!sycl_moe/*.md
!sycl_moe/*.sh
!sycl_moe/.gitignore
!sycl_moe/archive/
sycl_moe/archive/*
!sycl_moe/archive/*.md
sycl_moe/*.bak*
sycl_moe/bundle.bin
