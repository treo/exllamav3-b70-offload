# probe binaries and the built shim (build.sh regenerates them). Listed by name rather than by
# wildcard: `probe_*` would also swallow the probe_*.cpp sources, which are the point of this dir - and
# `probe_*` plus `!probe_*.cpp` would swallow probe_cross.py. Consequence of choosing safety here: a new
# probe_*.cpp must have its binary name added to this list in the same commit, or the ELF gets committed
# (it did, for probe_dpas4). `git status --porcelain` before committing shows it, but only if you look.
probe_transport
probe_doorbell
probe_notify
probe_resident
probe_stores
probe_stores2
probe_unreg
probe_coherency
probe_rates
probe_gemv
probe_dpas
probe_dpas2
probe_unpack
probe_dpas3
probe_dpas4
probe_dpas5
probe_dpas6
probe_dpas7
probe_dpas8
libb70shim.so
# IGC shader dumps (IGC_ShaderDumpEnable=1 IGC_DumpToCustomDir=...): ~1.2 MB of .isaasm/.spv/.ll per run
isa/
isa_*/
__pycache__/