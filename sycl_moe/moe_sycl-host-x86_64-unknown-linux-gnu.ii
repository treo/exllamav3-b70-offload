  }

  operator const T &() const noexcept {
    throw sycl::exception( sycl::make_error_code(sycl::errc::feature_not_supported), "Implicit conversion of device_global to T" " is not supported on host device.");
    return get();
  }

  device_global &operator=(const T &newValue) noexcept {
    throw sycl::exception( sycl::make_error_code(sycl::errc::feature_not_supported), "Assignment operator" " is not supported on host device.");
    *this->get_ptr() = newValue;
    return *this;
  }

  template <class RelayT = T>
  std::remove_reference_t<
      decltype(std::declval<RelayT>()[std::declval<std::ptrdiff_t>()])> &
  operator[](std::ptrdiff_t idx) noexcept {
    throw sycl::exception( sycl::make_error_code(sycl::errc::feature_not_supported), "Subscript operator" " is not supported on host device.");
    return (*this->get_ptr())[idx];
