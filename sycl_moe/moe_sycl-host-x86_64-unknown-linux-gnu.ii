    auto First = [&](auto KernelTag) {

      constexpr bool IsOneWG =
          std::is_same_v<std::remove_reference_t<decltype(KernelTag)>,
                         KernelOneWGTag>;

      constexpr size_t NElements = Reduction::num_elements;

      size_t WGSize = NDRange.get_local_range().size();

      auto Out = [&]() {
