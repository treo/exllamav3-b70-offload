    auto partial_res = sycl::exp2(sycl::detail::to_vec2(x, i * 2));

    sycl::detail::memcpy_no_adl(&res[i * 2], &partial_res,
                                sizeof(vec<half, 2>));
  }
  if (N % 2) {



    res[N - 1] = sycl::exp2(x[N - 1]);

  }
  return res;
}

}

}
}
