  template <backend BackendName, typename DataT, int Dimensions,
            typename Allocator>
  friend auto
  detail::get_native_buffer(const buffer<DataT, Dimensions, Allocator> &Obj)
      -> backend_return_t<BackendName, buffer<DataT, Dimensions, Allocator>>;

