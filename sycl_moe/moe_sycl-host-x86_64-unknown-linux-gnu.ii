  static constexpr std::size_t
  memory_required([[maybe_unused]] sycl::memory_scope scope,
                  std::size_t range_size) {
    return range_size * sizeof(ValT) +
           (1 << bits) * range_size * sizeof(uint32_t) + alignof(uint32_t);
  }
};

