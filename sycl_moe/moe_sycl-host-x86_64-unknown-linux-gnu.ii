    return *this->get_ptr();
  }

  template <class RelayT = T>
  std::enable_if_t<detail::HasArrowOperator<RelayT>::value ||
                       std::is_pointer_v<RelayT>,
                   const RelayT> &
  operator->() const noexcept {
    throw sycl::exception( sycl::make_error_code(sycl::errc::feature_not_supported), "operator-> on a device_global" " is not supported on host device.");
